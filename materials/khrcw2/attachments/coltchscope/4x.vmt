
"VertexLitGeneric"
{
	    "$basetexture"	"khrcw2/attachments/coltchscope/4x_diffuse"
    "$bumpmap"	"khrcw2/attachments/coltchscope/4x_normal"
	"$PhongExponentTexture"	"khrcw2/attachments/coltchscope/4x_exponent"
	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 1.4 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .01 .01 .01]"
	"$normalmapalphaenvmapmask" "1"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "1"
	"$rimmask" "1"

	"$detail" "khrcw2/attachments/coltchscope/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}