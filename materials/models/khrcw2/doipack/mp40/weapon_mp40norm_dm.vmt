"VertexLitGeneric"
{
	"$basetexture"					"models\khrcw2\doipack\mp40\weapon_mp40norm_dm"
	"$bumpmap" 						"models\khrcw2\doipack\mp40\weapon_mp40_nm"
	"$phongexponenttexture"		"models\khrcw2\doipack\mp40\weapon_mp40_exp"
	"$model"						"1"

//BASIC
    $color						"[ .75 .75 .75 ]"

//PHONG
	$phong                      "1"
	$phongtint                  "[ .67 .85 1 ]"
	$phongboost                	"15"
//	$phongexponent				"60"
	$phongfresnelranges       	"[ .1 .5 1 ]"

//ENVMAP
	$envmap						"env_cubemap"
//	$envmapfresnel 				"-1"
	$normalmapalphaenvmapmask	"1"
	$envmaptint               	"[ .05 .05 .05 ]"
}

